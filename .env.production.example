# Vercel frontend environment
VITE_API_BASE_URL=https://your-render-api.onrender.com

# Render API environment
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
REDIS_URL=rediss://default:PASSWORD@YOUR-UPSTASH-ENDPOINT:6379
JWT_ACCESS_SECRET=generate_a_long_random_secret
JWT_REFRESH_SECRET=generate_a_long_random_secret
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
UPLOAD_DIRECTORY=/tmp/cardacquire-uploads
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ASSISTANT_USE_LLM=true
KYC_USE_LLM=true