generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  APPLICANT
  ADMIN
}

enum ApplicationStatus {
  SUBMITTED
  KYC_IN_PROGRESS
  KYC_FAILED
  RISK_REVIEW
  PARTNER_VERIFICATION
  APPROVED
  REJECTED
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(320)
  passwordHash     String        @map("password_hash") @db.VarChar(255)
  role             UserRole      @default(APPLICANT)
  refreshTokenHash String?       @map("refresh_token_hash") @db.VarChar(255)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  applications     Application[]

  @@map("users")
}

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  user               User              @relation(fields: [userId], references: [id])
  dedupeKey          String            @unique @map("dedupe_key") @db.VarChar(255)
  applicantName      String            @map("applicant_name") @db.VarChar(200)
  dateOfBirth        DateTime          @map("date_of_birth") @db.Date
  idDocumentUrl      String?           @map("id_document_url") @db.VarChar(2048)
  deviceFingerprint  String?           @map("device_fingerprint") @db.VarChar(255)
  ipAddress          String?           @map("ip_address") @db.Inet
  status             ApplicationStatus @default(SUBMITTED)
  kycExtractedName  String?           @map("kyc_extracted_name") @db.VarChar(200)
  kycIdNumber       String?           @map("kyc_id_number") @db.VarChar(255)
  kycFailureReason  String?           @map("kyc_failure_reason") @db.VarChar(500)
  riskScore         Int?              @map("risk_score")
  riskFlags         Json?             @map("risk_flags")
  decisionReason    String?           @map("decision_reason") @db.VarChar(1000)
  submittedAt       DateTime          @default(now()) @map("submitted_at")
  processingStarted DateTime?         @map("processing_started_at")
  processingFinished DateTime?        @map("processing_finished_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  auditTrail        AuditTrail[]

  @@index([userId])
  @@index([status])
  @@index([deviceFingerprint, createdAt])
  @@map("applications")
}

model AuditTrail {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  application   Application       @relation(fields: [applicationId], references: [id])
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  event         String            @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("audit_trail")
}