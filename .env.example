# Local-only development defaults. Never commit real credentials or API keys.
POSTGRES_DB=cardacquire
POSTGRES_USER=cardacquire
POSTGRES_PASSWORD=cardacquire_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://cardacquire:cardacquire_local_only@localhost:5432/cardacquire
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=application-processing
KYC_SERVICE_URL=http://localhost:8000
KYC_USE_LLM=true
API_PORT=3000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIRECTORY=uploads

# Prisma uses this connection string for schema validation and migrations.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ASSISTANT_USE_LLM=true
BANK_PARTNER_URL=http://localhost:4000
BANK_PARTNER_PORT=4000
BANK_PARTNER_LATENCY_MIN_MS=100
BANK_PARTNER_LATENCY_MAX_MS=500
BANK_PARTNER_FAILURE_RATE=0